pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                sh '''
                rm -rf redbus
                git clone https://github.com/Maksud-Husen/redbus-docker-conf.git
                '''              
            }
        }

        stage('Build img') {
            steps {
                echo 'Building Docker images...'

                sh '''
                cd redbus-docker-conf
                docker compose -f docker-compose.yml build
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                cd redbus-docker-conf
                docker compose -f docker-compose.yml build
                '''
            }
        }
    }

    post {
        always {
            echo 'Build completed.'
        }
        failure {
            echo 'Build failed.'
        }
    }
}
