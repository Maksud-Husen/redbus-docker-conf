pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                sh '''
                rm -rf redbus-docker-conf
                git clone https://github.com/Maksud-Husen/redbus-docker-conf.git
                '''              
            }
        }

        stage('Debug - List Files') {
            steps {
                dir('redbus-docker-conf/redbus') {
                    sh 'ls -la'
                }
            }
        }

        stage('Build img') {
            steps {
                echo 'Building Docker images...'

                sh 'docker compose -f redbus-docker-conf/redbus/docker-compose.yml build'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh 'docker compose -f redbus-docker-conf/redbus/docker-compose.yml up -d'
            }
        }
    }

    post {
        always {
            echo 'Build completed.'
        }
        failure {
            echo 'Build failed.'
        }
    }
}
